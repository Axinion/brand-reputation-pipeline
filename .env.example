# Copy this file to .env and fill in your values
# Never commit .env - it is in .gitignore

NEWS_API_KEY=your_newsapi_key_here
REDDIT_USER_AGENT=brand-monitor/1.0

# Alerting (Week 3)
# Slack: create a free workspace at slack.com, add an Incoming Webhook app
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/WEBHOOK/URL

# Email: Gmail App Password (myaccount.google.com → Security → App Passwords)
ALERT_EMAIL_FROM=youremail@gmail.com
ALERT_EMAIL_TO=youremail@gmail.com
ALERT_EMAIL_PASSWORD=your_app_password_here
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587

# LLM Report Generation (Week 4)
# Groq: get a free API key at console.groq.com
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile
